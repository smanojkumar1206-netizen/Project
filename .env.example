# AgriConnect & AgriAI Configuration

# Data Mode: 'demo' (mock/seed data) or 'supabase' (live PostgreSQL)
DATA_MODE=demo

# AI Mode API Credentials (Never expose in frontend code)
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Supabase Credentials (optional for live database)
