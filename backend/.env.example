# Operational Data Mode: 'mongodb' or 'demo'
DATA_MODE=mongodb

# MongoDB Connection Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agriconnect

# JWT Secret & Token Configuration
JWT_SECRET=agriconnect-jwt-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Provider Credentials (Optional)
EMAIL_PROVIDER_API_KEY=your_email_api_key
EMAIL_FROM=notifications@agriconnect.org

# SMS Provider Credentials (Optional)
SMS_PROVIDER_API_KEY=your_sms_api_key
SMS_PROVIDER_SENDER_ID=AGRI_CONN

# AI API Credentials (Optional)
LLM_API_KEY=your_llm_api_key
STT_API_KEY=your_stt_api_key
TTS_API_KEY=your_tts_api_key

# FastAPI Server Port
PORT=8000
